{
  "name": "acct-sh",
  "version": "0.1.3",
  "description": "Directory-scoped GitHub identity and auth — one account, one identity, one directory tree",
  "type": "module",
  "main": "./dist/cli/index.js",
  "types": "./dist/cli/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/cli/index.d.ts",
      "import": "./dist/cli/index.js"
    }
  },
  "bin": {
    "acct": "bin/acct.js",
    "git-credential-acct": "bin/git-credential-acct.js"
  },
  "files": [
    "bin",
    "dist",
    "hooks",
    "shell",
    "LICENSE",
    "README.md",
    "CHANGELOG.md",
    "logo.svg"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsc -p tsconfig.json --watch",
    "test": "vitest run",
    "test:e2e": "npm run build && node scripts/e2e-extensive.mjs",
    "test:security": "npm run build && node scripts/e2e-security-regression.mjs",
    "test:watch": "vitest",
    "lint": "tsc -p tsconfig.json --noEmit",
    "pack:check": "npm pack --dry-run",
    "prepublishOnly": "npm run lint && npm run build && npm test"
  },
  "engines": {
    "node": ">=20"
  },
  "keywords": [
    "git",
    "github",
    "gh",
    "credential",
    "multi-account",
    "identity"
  ],
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "homepage": "https://github.com/acct-sh/acct#readme",
  "bugs": {
    "url": "https://github.com/acct-sh/acct/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/acct-sh/acct.git"
  },
  "dependencies": {
    "@napi-rs/keyring": "^1.1.2",
    "commander": "^12.1.0",
    "yaml": "^2.5.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
