{
  "name": "acct-sh",
  "version": "0.2.0",
  "description": "Directory-scoped GitHub identity and auth — one account, one identity, one directory tree",
  "type": "module",
  "main": "./dist/cli/index.js",
  "types": "./dist/cli/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/cli/index.d.ts",
      "import": "./dist/cli/index.js"
    }
  },
  "bin": {
    "acct": "bin/acct.js",
    "git-credential-acct": "bin/git-credential-acct.js"
  },
  "files": [
    "bin",
    "data",
    "dist",
    "hooks",
    "scripts/postinstall.mjs",
    "shell",
    "LICENSE",
    "README.md",
    "CHANGELOG.md",
    "logo.svg",
    "og.jpeg"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsc -p tsconfig.json --watch",
    "test": "node scripts/test-isolated.mjs node node_modules/vitest/vitest.mjs run",
    "test:e2e": "npm run build && node scripts/test-isolated.mjs node scripts/e2e-extensive.mjs",
    "test:security": "npm run build && node scripts/test-isolated.mjs node scripts/e2e-security-regression.mjs",
    "cleanup:e2e-repos": "node scripts/cleanup-e2e-repos.mjs",
    "test:watch": "node scripts/test-isolated.mjs node node_modules/vitest/vitest.mjs",
    "lint": "tsc -p tsconfig.json --noEmit",
    "pack:check": "npm pack --dry-run",
    "pack:smoke": "node scripts/test-isolated.mjs --copy-cache node scripts/pack-smoke.mjs",
    "postinstall": "node ./scripts/postinstall.mjs",
    "prepublishOnly": "npm run lint && npm run build && npm test && npm run pack:check && npm run pack:smoke",
    "format": "prettier --write src tests scripts bin",
    "format:check": "prettier --check src tests scripts bin"
  },
  "engines": {
    "node": ">=20"
  },
  "keywords": [
    "git",
    "github",
    "gh",
    "credential",
    "credential-helper",
    "multi-account",
    "github-multi-account",
    "identity",
    "includeIf",
    "directory-scoped",
    "keychain",
    "developer-tools",
    "acct"
  ],
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "homepage": "https://acct-web.vercel.app/",
  "bugs": {
    "url": "https://github.com/abdull-ah-med/acct/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/abdull-ah-med/acct.git"
  },
  "dependencies": {
    "@napi-rs/keyring": "^1.1.2",
    "commander": "^12.1.0",
    "yaml": "^2.5.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "prettier": "3.9.10",
    "typescript": "^5.7.2",
    "vitest": "^4.1.11"
  }
}
