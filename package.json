{
  "name": "acct",
  "version": "0.0.0",
  "description": "Directory-scoped GitHub identity and auth — one account, one identity, one directory tree",
  "type": "module",
  "bin": {
    "acct": "./bin/acct.js",
    "git-credential-acct": "./bin/git-credential-acct.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsc -p tsconfig.json --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "tsc -p tsconfig.json --noEmit",
    "test:e2e": "npm run build && node scripts/e2e-extensive.mjs"
  },
  "engines": {
    "node": ">=20"
  },
  "keywords": [
    "git",
    "github",
    "gh",
    "credential",
    "multi-account",
    "identity"
  ],
  "license": "MIT",
  "dependencies": {
    "@napi-rs/keyring": "^1.1.2",
    "commander": "^12.1.0",
    "yaml": "^2.5.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
